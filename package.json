{
  "name": "supercooked-multiplayer",
  "version": "1.0.0",
  "description": "Browser-based multiplayer cooking game with Three.js and Node.js",
  "type": "module",
  "engines": {
    "node": ">=16.0.0"
  },
  "scripts": {
    "build:css": "postcss ./public/css/input.css -o ./public/css/tailwind.css --minify",
    "watch:css": "postcss ./public/css/input.css -o ./public/css/tailwind.css --watch",
    "dev": "node server/index.js",
    "start": "node server/index.js"
  },
  "keywords": [
    "threejs",
    "multiplayer",
    "webgl",
    "socketio",
    "game"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "bcrypt": "^6.0.0",
    "dotenv": "^17.2.3",
    "express": "^4.18.2",
    "pg": "^8.16.3",
    "socket.io": "^4.6.1",
    "@tailwindcss/postcss": "^4.1.17",
    "autoprefixer": "^10.4.22",
    "postcss": "^8.5.6",
    "postcss-cli": "^11.0.1",
    "tailwindcss": "^4.1.17"
  },
  "devDependencies": {
  }
}
